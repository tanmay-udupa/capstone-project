# .env.example — copy to .env and fill in relevant values.
# NEVER commit .env to source control.

# ── Azure SQL ─────────────────────────────────────────────────────────────────
SQL_SERVER=capstone-sqlserver.database.windows.net
SQL_DATABASE=pipelinedb-dev
SQL_USERNAME=sqladmin
SQL_PASSWORD=your-sql-password

# ── Azure AD / Entra ID ───────────────────────────────────────────────────────
TENANT_ID=425a5546-5a6e-4f1b-ab62-23d91d07d893
CLIENT_ID=a3e163cd-830c-4b9c-be5e-446930fcfa6f

# ── Azure DevOps ──────────────────────────────────────────────────────────────
ADO_ORG=AVEVA-VSTS
ADO_PAT=your-ado-pat

# ── Azure OpenAI ────────────────────────
AZURE_OPENAI_ENDPOINT=https://capstone-pipeline-llm.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
LLM_ENABLED=True
